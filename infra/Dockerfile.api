# Imagem da API (NestJS + Prisma).
# Build multi-stage: compila o TypeScript e leva apenas o necessario.
FROM node:22-bookworm-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
RUN npm ci --workspace @rota/shared --workspace @rota/api --include-workspace-root

FROM deps AS build
COPY packages/shared packages/shared
COPY apps/api apps/api
# Gera o Prisma Client DENTRO da imagem. Depender so do prebuild do npm torna a
# geracao implicita e ja falhou no deploy: o `npm ci` do estagio deps dispara o
# postinstall do @prisma/client antes do schema.prisma estar na imagem, e o
# client gerado nao serve ao runtime de Debian 12. Aqui o schema ja existe.
RUN npx prisma generate --schema apps/api/prisma/schema.prisma \
 && npm run build -w @rota/shared \
 && npm run build -w @rota/api

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production

# curl para o healthcheck do container.
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl \
 && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
RUN npm ci --omit=dev --workspace @rota/shared --workspace @rota/api --include-workspace-root \
 && npm cache clean --force

COPY --from=build /app/packages/shared/dist packages/shared/dist
COPY --from=build /app/apps/api/dist apps/api/dist
COPY --from=build /app/apps/api/prisma apps/api/prisma
COPY --from=build /app/node_modules/.prisma node_modules/.prisma

WORKDIR /app/apps/api

# Railway/Fly injetam PORT dinamicamente (often 8080). Forma shell para o
# healthcheck expandir a variavel; a API tambem le PORT do ambiente
# (ver apps/api/src/config/configuration.ts).
EXPOSE 4000

# Migrations sao aplicadas por passo separado (ver DEPLOY.md), para que uma
# falha nao derrube uma API que ja estava no ar.
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD curl -fsS "http://localhost:${PORT:-4000}/api/docs-json" || exit 1

CMD ["node", "dist/main.js"]
