<?xml version="1.0" encoding="utf-8"?>
<!--
  Icone provisorio do app: um disco simples em `res/`, sem PNG binario.

  O manifesto referenciava @mipmap/ic_launcher, mas nao existia nenhum recurso
  de mipmap no projeto. O aapt falha no link com "resource mipmap/ic_launcher
  not found" — e como o manifesto e resolvido antes de qualquer codigo Kotlin,
  o build inteiro quebrava sem mensagem util.

  Por que vector drawable e nao PNG: e texto, versiona em texto, e nao exige
  gerar binarios em varios densities. Substituir por um icone de verdade e
  trabalho de design (pendencia junto com a identidade visual); ate la, um
  disco honesto e melhor do que build quebrado.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#0F172A"
        android:pathData="M0,0h108v108h-108z" />

    <path
        android:strokeColor="#38BDF8"
        android:strokeWidth="5"
        android:fillColor="#00000000"
        android:pathData="M54,26 A28,28 0 1,1 53.9,26" />

    <path
        android:fillColor="#38BDF8"
        android:pathData="M54,48 L58,62 L54,80 L50,62 Z" />
</vector>