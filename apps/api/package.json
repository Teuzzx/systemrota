{
  "name": "@rota/api",
  "version": "1.0.0",
  "private": true,
  "description": "Backend da Plataforma de Gestao Logistica: NestJS + Prisma + PostgreSQL/PostGIS, regras de negocio, idempotencia, WebSocket.",
  "scripts": {
    "prebuild": "npm run db:generate",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node dist/main.js",
    "dev": "ts-node -T src/main.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:sql": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script",
    "db:pglite": "node src/db/pglite-dev.mjs",
    "db:seed:demo": "ts-node -T src/db/seed-demo.ts",
    "db:seed:core": "ts-node -T src/db/seed-core-cli.ts",
    "db:create-admin": "ts-node -T src/db/create-admin-cli.ts",
    "test": "jest --runInBand --detectOpenHandles=false",
    "test:ci": "jest --runInBand --ci"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@electric-sql/pglite-postgis": "0.2.9",
    "@electric-sql/pglite-socket": "0.2.12",
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.7",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/platform-socket.io": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/websockets": "11.2.7",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "6.19.3",
    "@rota/shared": "1.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "compression": "1.8.1",
    "csv-parse": "5.6.0",
    "csv-stringify": "6.5.2",
    "exceljs": "4.4.0",
    "express-rate-limit": "7.5.0",
    "helmet": "8.1.0",
    "pg": "^8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.7",
    "@types/compression": "1.8.1",
    "@types/express": "5.0.3",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.5",
    "@types/supertest": "6.0.3",
    "@typescript-eslint/eslint-plugin": "8.46.1",
    "@typescript-eslint/parser": "8.46.1",
    "eslint": "8.57.1",
    "jest": "29.7.0",
    "prisma": "6.19.3",
    "supertest": "7.3.1",
    "ts-jest": "29.4.14",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
