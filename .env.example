# ---------------------------------------------------------------------------
# Variaveis de ambiente — NAO CONTEM SEGREDOS REAIS.
# Copie para .env e preencha com os valores do seu ambiente.
# ---------------------------------------------------------------------------

# ============================ APLICACAO ====================================
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000

# ============================ BANCO DE DADOS ===============================
# MODO DE PRODUCAO (recomendado): PostgreSQL 16 + PostGIS (ver infra/docker-compose.yml)
DB_DRIVER=postgresql
# Url real do Postgres. Em producao e OBRIGATORIA.
DATABASE_URL=postgresql://rota:troque-esta-senha@localhost:5432/rota?schema=public

# MODO DE VERIFICACAO LOCAL (sem Docker/psql): PGlite = PostgreSQL em WASM
# com PostGIS real, exposto por socket. Use DB_DRIVER=pglite e deixe a Url
# vazia: a aplicacao sobe o proprio banco localmente.
# DB_DRIVER=pglite
# PGLITE_PORT=54329
# PGLITE_DATA_DIR=.pglite/local

# Transporte do Prisma. `engine` = binario nativo (producao, prepared
# statements e pool de conexoes). `pg-adapter` = node-postgres, usado contra o
# PGlite, cujo servidor de socket nao suporta prepared statements nomeados.
# DB_TRANSPORT=engine

# ============================ AUTENTICACAO =================================
# Gere com: openssl rand -base64 48
# Em producao e OBRIGATORIA e precisa ter ao menos 32 caracteres.
JWT_ACCESS_SECRET=troque-este-segredo-por-um-valor-aleatorio-longo
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=14
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15

# ============================ MAPAS E ROTAS ================================
# Padrao: heuristic (offline, sem chave, sem rede). Calcula tempos por
# aproximacao: o resultado e sempre rotulado como ESTIMADO.
ROUTING_PROVIDER=heuristic

# Alternativa 1: OSRM self-hosted (sem chave, sem custo, exige infraestrutura).
# ROUTING_PROVIDER=osrm
# OSRM_BASE_URL=http://localhost:5000

# Alternativa 2: GraphHopper (comercial, exige credencial — ver PENDENCIAS.md).
# ROUTING_PROVIDER=graphhopper
# GRAPHHOPPER_URL=https://api.graphhopper.com
# GRAPHHOPPER_API_KEY=
ROUTING_TIMEOUT_MS=5000

# ============================ OPERACAO ======================================
# Retencao de localizacao (privacidade/LGPD).
LOCATION_RETENTION_DAYS=90
AGGREGATE_RETENTION_DAYS=730

# Tempo medio de atendimento quando cliente e rota nao definem valor.
DEFAULT_SERVICE_SECONDS=900

# Seed de demonstracao: recusa rodar se false ou em producao.
ALLOW_DEMO_SEED=true

# ============================ LIMITES DE REQUISICAO ========================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=10

# ============================ WEB (apps/web) ===============================
# Vazio = usar o proxy interno do Next (/api -> API).
# NEXT_PUBLIC_API_URL=
API_INTERNAL_URL=http://127.0.0.1:4000

# ============================ ANDROID (apps/android) ========================
# A URL da API entra no build do APK (BuildConfig), nunca como segredo.
# apiBaseUrl=https://api.seu-dominio.com
